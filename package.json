{
    "name": "@ipsadt/tg-widgets",
    "version": "0.3.0",
    "description": "Zero-runtime TSX UI Kit and type-safe grammY plugin for Telegram Bot API 10.4 HTML Widgets (Interactive Bubbles)",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "bun": "./dist/bun/index.js",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./components": {
            "types": "./dist/components/index.d.ts",
            "bun": "./dist/bun/components/index.js",
            "import": "./dist/components/index.js",
            "require": "./dist/components/index.cjs",
            "default": "./dist/components/index.js"
        },
        "./jsx-runtime": {
            "types": "./dist/jsx-runtime.d.ts",
            "bun": "./dist/bun/jsx-runtime.js",
            "import": "./dist/jsx-runtime.js",
            "require": "./dist/jsx-runtime.cjs",
            "default": "./dist/jsx-runtime.js"
        },
        "./jsx-dev-runtime": {
            "types": "./dist/jsx-dev-runtime.d.ts",
            "bun": "./dist/bun/jsx-dev-runtime.js",
            "import": "./dist/jsx-dev-runtime.js",
            "require": "./dist/jsx-dev-runtime.cjs",
            "default": "./dist/jsx-dev-runtime.js"
        },
        "./mod": {
            "types": "./mod.ts",
            "import": "./mod.ts",
            "default": "./mod.ts"
        },
        "./mod.ts": {
            "types": "./mod.ts",
            "import": "./mod.ts",
            "default": "./mod.ts"
        }
    },
    "files": [
        "dist",
        "mod.ts",
        "deno.json",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "bun build.ts",
        "build:watch": "bun build.ts --watch",
        "build:fast": "bun build.ts --no-types",
        "build:clean": "rm -rf dist",
        "check": "tsc --noEmit",
        "check:branch": "bun run scripts/check-branch.ts",
        "check:compression": "bun run scripts/compare-compression.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "bun run check && bun run format:check",
        "test": "bun test",
        "version:bump": "bun run scripts/bump-version.ts",
        "release": "bun run scripts/bump-version.ts --commit",
        "example": "bun run examples/bot.tsx",
        "prepublishOnly": "bun run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "author": {
        "name": "naylour",
        "email": "naylour@tuta.io",
        "url": "https://github.com/naylour"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/SSA-IPSaDT/tg-widgets.git"
    },
    "bugs": {
        "url": "https://github.com/SSA-IPSaDT/tg-widgets/issues"
    },
    "homepage": "https://github.com/SSA-IPSaDT/tg-widgets#readme",
    "keywords": [
        "telegram",
        "telegram-bot",
        "telegram-widgets",
        "tg-widgets",
        "html-bubbles",
        "grammy",
        "grammy-plugin",
        "tsx",
        "zero-runtime",
        "ui-kit",
        "deno",
        "bot-api-10-4",
        "compression",
        "minification",
        "quickjs",
        "lucide",
        "lucide-icons",
        "shadcn"
    ],
    "peerDependencies": {
        "grammy": ">=1.20.0"
    },
    "devDependencies": {
        "@types/bun": "^1.2.0",
        "@types/html-minifier-terser": "^7.0.2",
        "@types/react": "^19.3.0",
        "grammy": "^1.46.0",
        "prettier": "^3.10.1",
        "typescript": "^5.7.0"
    },
    "dependencies": {
        "html-minifier-terser": "^7.2.0",
        "lucide-static": "^1.72.0"
    }
}
