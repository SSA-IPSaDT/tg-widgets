# Токен вашего Telegram-бота (получите у @BotFather)
BOT_TOKEN=

# Использовать тестовый сервер Telegram (Test Environment / Test DC)
# Позволяет тестировать виджеты в группах, пересылку и inline-режим (Bot API 10.4)
# Значения: true / false
TELEGRAM_TEST_ENV=false

# Кастомный URL локального Bot API сервера (опционально)
# BOT_API_ROOT=https://api.telegram.org
