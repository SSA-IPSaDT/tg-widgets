amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

// Telegram Widgets (tg-widgets) Git Hook Pipeline
// Documentation: https://hk.jdx.dev

hooks {
    ["commit-msg"] {
        steps {
            ["conventional_commits"] {
                check = "hk util check-conventional-commit {{commit_msg_file}}"
            }
        }
    }

    ["pre-commit"] {
        steps {
            ["no_commit_to_main"] {
                check = "hk util no-commit-to-branch --branch main --branch master"
            }
            ["check_branch_convention"] {
                check = "sh -c 'branch=$(git rev-parse --abbrev-ref HEAD); case \"$branch\" in feat/*|fix/*|chore/*|docs/*|refactor/*|test/*|perf/*|release/*|hotfix/*|main|master|HEAD) exit 0;; *) echo \"Branch $branch must match conventional naming (feat/, fix/, chore/, docs/, refactor/, test/, perf/, release/, hotfix/)\"; exit 1;; esac'"
            }
            ["check_merge_conflict"] = Builtins.check_merge_conflict
            ["trailing_whitespace"] = Builtins.trailing_whitespace
            ["detect_private_key"] = Builtins.detect_private_key
            ["check_added_large_files"] {
                glob = "**/*"
                exclude = ".*\\.(mp4|webm|gif|png|jpg|jpeg)$"
                check = "sh -c 'if [ \"$#\" -gt 0 ]; then hk util check-added-large-files \"$@\"; fi' --"
            }
            ["format"] {
                glob = "**/*.{ts,tsx,js,jsx,json,md,toml}"
                check = "bun run format:check"
                fix = "bun run format"
            }
            ["typecheck"] {
                glob = "**/*.{ts,tsx}"
                check = "bun run check"
            }
        }
    }

    ["pre-push"] {
        steps {
            ["build_artifacts"] {
                check = "bun run build"
            }
            ["test_suite"] {
                check = "bun test"
            }
        }
    }
}
