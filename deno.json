{
    "name": "@ipsadt/tg-widgets",
    "version": "0.3.0",
    "exports": {
        ".": "./mod.ts",
        "./components": "./src/components/index.ts",
        "./jsx-runtime": "./src/jsx-runtime.ts",
        "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts"
